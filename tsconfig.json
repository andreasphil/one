{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "paths": {
      "@andreasphil/command-bar": ["./web/static/common/command-bar/commandBar.d.ts"]
    },
    "skipLibCheck": true,
    "target": "esnext",
    "verbatimModuleSyntax": true
  },
  "exclude": ["**/*.config.js", "./dist/**/*"],
  "include": ["web/static/**/*.js", "web/static/**/*.ts"]
}
